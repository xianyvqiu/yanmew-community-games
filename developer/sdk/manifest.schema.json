{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:yanmew:game:manifest:1.0.0",
  "type": "object", "additionalProperties": false,
  "required": ["id", "name", "description", "author", "version", "api_version", "entry", "storage_version"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$", "maxLength": 128},
    "name": {"type": "string", "minLength": 1, "maxLength": 100},
    "description": {"type": "string", "minLength": 1, "maxLength": 2000},
    "author": {"type": "string", "minLength": 1, "maxLength": 100},
    "version": {"type": "string", "description": "SemVer, checked by the shared Rust validator"},
    "api_version": {"const": "1.0.0"},
    "entry": {"type": "string", "pattern": "^ui/[A-Za-z0-9_./-]+\\.html$", "maxLength": 240},
    "storage_version": {"type": "integer", "minimum": 1},
    "permissions": {"type": "array", "items": {"enum": ["wallet.modify", "network.fetch"]}, "uniqueItems": true, "default": []},
    "network_origins": {"type": "array", "items": {"type": "string", "pattern": "^https://"}, "uniqueItems": true, "maxItems": 16, "default": []},
    "settings_schema": {"type": "array", "items": {"$ref": "#/$defs/setting"}, "maxItems": 64, "default": []},
    "repository": {"type": ["string", "null"], "description": "Credential-free HTTPS github.com URL"},
    "homepage": {"type": ["string", "null"], "description": "Credential-free HTTPS URL"},
    "release_page": {"type": ["string", "null"], "description": "Credential-free HTTPS URL"},
    "migration": {"type": ["string", "null"], "description": "Safe relative .js ES module exporting migrate(snapshot, targetVersion)"}
  },
  "$defs": {
    "setting": {
      "type": "object", "additionalProperties": false, "required": ["key", "title", "type", "default"],
      "properties": {
        "key": {"type": "string", "pattern": "^[a-z0-9_-]+(\\.[a-z0-9_-]+)*$", "maxLength": 128},
        "title": {"type": "string", "minLength": 1}, "description": {"type": "string", "default": ""},
        "type": {"enum": ["boolean", "integer", "number", "string", "enum"]}, "default": {},
        "required": {"type": "boolean", "default": false},
        "minimum": {"type": ["number", "null"]}, "maximum": {"type": ["number", "null"]},
        "options": {"type": "array", "maxItems": 100, "items": {"type": "object", "required": ["value", "label"], "additionalProperties": false, "properties": {"value": {}, "label": {"type": "string"}}}, "default": []}
      }
    }
  },
  "$comment": "Editor assistance only. Shared Rust validation additionally checks UTF-8 byte limits, types/defaults, duplicate keys, SemVer, canonical origins and safe paths. Schema validation alone cannot authorize installation."
}
